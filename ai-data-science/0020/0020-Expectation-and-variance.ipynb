   "source": [
    "import numpy as np\n",
    "x = np.array([-10., 0., 30.])\n",
    "p = np.array([0.25, 0.50, 0.25])\n",
    "mu = (x * p).sum()\n",
    "variance = ((x - mu) ** 2 * p).sum()\n",
    "sd = np.sqrt(variance)\n",
    "print(mu, variance, sd)"
   ]
  }
